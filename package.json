{
  "name": "nailong-planner",
  "version": "0.1.0",
  "private": true,
  "description": "A self-hosted, two-person household planner with a nested, shade-inheriting calendar hierarchy.",
  "license": "MIT",
  "author": "Andrew (https://github.com/andrewhmir)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewhmir/nailong-planner.git"
  },
  "bugs": {
    "url": "https://github.com/andrewhmir/nailong-planner/issues"
  },
  "homepage": "https://github.com/andrewhmir/nailong-planner#readme",
  "keywords": [
    "calendar",
    "planner",
    "household",
    "nextjs",
    "fullcalendar",
    "sqlite",
    "drizzle",
    "better-auth",
    "tailwindcss"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx scripts/seed-test-db.mts && playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.mts",
    "provision": "tsx scripts/provision.mts",
    "reset-password": "tsx scripts/reset-password.mts",
    "backup": "tsx scripts/backup.mts",
    "restore-check": "tsx scripts/restore-check.mts",
    "ops:bundle": "esbuild scripts/provision.mts scripts/backup.mts scripts/reset-password.mts --bundle --platform=node --format=esm --target=node22 --external:better-sqlite3 --outdir=ops --out-extension:.js=.mjs",
    "docs:check": "node scripts/docs-check.mjs"
  },
  "dependencies": {
    "@fullcalendar/react": "7.1.3",
    "@fullcalendar/rrule": "7.1.3",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@tanstack/react-query": "5.104.4",
    "better-auth": "1.7.11",
    "better-sqlite3": "13.0.3",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "ical.js": "2.2.1",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rrule": "2.8.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "temporal-polyfill": "1.0.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource/lato": "5.3.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
