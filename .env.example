# Copy to .env.local for development and to the Railway environment for deploy.

# Where the SQLite database lives. Inside Docker this is file:/data/planner.db.
# Required in production: the ./data default below is container-local and is lost
# on redeploy, so the app refuses to start in production without an explicit path.
DATABASE_URL=file:./data/planner.db

# URL the app is served from (used by Better Auth for cookies and origin checks).
# In production this must be the exact public origin, e.g.
# https://nailong.up.railway.app - scheme included, no trailing slash.
BETTER_AUTH_URL=http://localhost:3000

# At least 32 random characters. Generate with: openssl rand -base64 32
# Required in production: without it /api/health returns 503 and the deploy fails.
BETTER_AUTH_SECRET=

NODE_ENV=development
TZ=Asia/Taipei

# Leave unset in production. "off" disables sign-in throttling and is only for
# local E2E runs where every request shares one loopback IP.
AUTH_RATE_LIMIT=

# Used once by `npm run provision` (or `node ops/provision.mjs` in the container)
# to create the two accounts. Delete afterwards.
SEED_USER_1_NAME=
SEED_USER_1_EMAIL=
SEED_USER_1_PASSWORD=
SEED_USER_2_NAME=
SEED_USER_2_EMAIL=
SEED_USER_2_PASSWORD=
